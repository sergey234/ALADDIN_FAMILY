# Общий секрет с ботом / partner_api (как VPN_API_HMAC_SECRET в shared/.env магазина).
VPN_API_HMAC_SECRET=

# Путь к SQLite (на проде: /opt/aladdin-shop-vpn-api/var/vpn.db).
VPN_DB_PATH=./var/vpn.db

# Интерфейс WireGuard для /ready (пусто = не проверять).
VPN_WG_INTERFACE=wg0

# Локально: 1 = воркер помечает provision успешным без wg (только для разработки).
VPN_DEV_STUB_WG=0

# Каталог приватных ключей клиентов (chmod 700). См. deploy/VPN04_WIREGUARD_RUNBOOK.md
# WG_KEYS_DIR=/opt/aladdin-shop-vpn-api/var/wg-keys

# Для POST /internal/v1/wg.conf — Endpoint в [Peer] и путь к публичному ключу сервера WireGuard.
# VPN_WG_ENDPOINT_HOST=aladdin-ai.ru
# VPN_WG_LISTEN_PORT=51820
# VPN_WG_SERVER_PUBLIC_KEY_PATH=/etc/wireguard/server_public.key

# Опционально: после успешного provision (при VPN_DEV_STUB_WG=1 — после коммита в vpn.db): script <telegram_user_id>
# Под root: .../wg-peer-up.sh. Под пользователем сервиса + sudoers: .../wg-peer-up-sudo.sh (см. deploy/VPN13_*).
# VPN_WG_POST_PROVISION_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/wg-peer-up.sh

# Пользователь процесса API/воркера — для chown клиентских *.key после записи от root (vpn-13).
# VPN_SERVICE_USER=aladdin-shop-vpn

# Подписка REALITY (vpn-05): шаблон в env (приоритет) или файл. Плейсхолдеры: {opaque_token}, {xray_uuid}, {host}, {port}, {pbk}, {sid}, {sni}, {fp}
# VPN_SUBSCRIBE_VLESS_TEMPLATE=vless://{xray_uuid}@{host}:{port}?encryption=none&security=reality&sni={sni}&fp={fp}&pbk={pbk}&sid={sid}&type=tcp&flow=xtls-rprx-vision#vpn-{opaque_token}
# VPN_SUBSCRIBE_BODY_FILE=/opt/aladdin-shop-vpn-api/var/subscription-body.txt
# VPN_XRAY_PUBLIC_HOST=aladdin-ai.ru
# VPN_XRAY_PORT=8443
# VPN_XRAY_DEFAULT_CLIENT_UUID=   # общий UUID в xray clients[] на одной ноде; per-user — после xray-peer-sync
# VPN_XRAY_REALITY_PUBLIC_KEY=
# VPN_XRAY_REALITY_SHORT_ID=
# VPN_XRAY_REALITY_SNI=www.microsoft.com
# VPN_WG_CLIENT_MTU=1280

# P2: воркер ротирует opaque_token при vpn_expired (старая /sub/ → 404).
# P3: учёт GET /sub/ в sub_access_log; алерт в ops-health бота при > N/ч (шаринг).
# VPN_SUB_ACCESS_ALERT_PER_HOUR=120
# VPN_WG_POST_EXPIRE_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/wg-peer-down.sh
# VPN_XRAY_POST_EXPIRE_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/xray-peer-down.sh
# VPN_XRAY_POST_PROVISION_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/xray-peer-up.sh

# Egress-ноды (vpn-30 prep): deploy/VPN30_SINGLE_NODE_MAX.md
# VPN_EGRESS_NODES_JSON=[{"id":"primary","wg_host":"149.154.65.180","wg_port":51820,"reality_port":8443,"ovpn_port":1194,"active":true},{"id":"secondary","wg_host":"","wg_port":51820,"active":false}]

# OpenVPN fallback (vpn-06): UDP 1194; per-user .ovpn в VPN_OVPN_PROFILES_DIR
# VPN_OVPN_REMOTE_PORT=1194
# VPN_OVPN_PROFILES_DIR=/opt/aladdin-shop-vpn-api/var/ovpn-profiles
# VPN_OVPN_CLIENT_ISSUE_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/openvpn-client-issue.sh

# Опционально: после expire по paid_until или revoke→vpn_expired: script <telegram_user_id>
# VPN_WG_POST_EXPIRE_SCRIPT=/opt/aladdin-shop-vpn-api/scripts/wg-peer-down.sh
# VPN_XRAY_POST_PROVISION_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/xray-peer-up.sh
# VPN_XRAY_POST_EXPIRE_SCRIPT=/opt/aladdin-shop-vpn-api/deploy/scripts/xray-peer-down.sh
