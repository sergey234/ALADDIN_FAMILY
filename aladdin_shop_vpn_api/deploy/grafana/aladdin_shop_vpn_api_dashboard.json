        { "expr": "aladdin_shop_vpn_jobs_pending", "legendFormat": "pending", "refId": "A" },
        { "expr": "aladdin_shop_vpn_jobs_processing", "legendFormat": "processing", "refId": "B" },
        { "expr": "aladdin_shop_vpn_jobs_failed", "legendFormat": "failed", "refId": "C" },
        { "expr": "aladdin_shop_vpn_jobs_done", "legendFormat": "done", "refId": "D" }
      ],
      "title": "Jobs (from vpn.db at scrape)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
