# Пример клиента (подставить remote, cert/key блоки или tls-auth).
# См. deploy/VPN06_OPENVPN_FALLBACK_RUNBOOK.md

client
dev tun
proto udp
remote YOUR_HOST 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
verb 3
key-direction 1

<ca>
# вставить содержимое ca.crt
</ca>

<tls-crypt>
# вставить содержимое tls-crypt.key (та же сторона, что key-direction 1 на сервере)
</tls-crypt>

# Вариант с клиентским cert (рекомендуется вместо логина/пароля):
# <cert> ... </cert>
# <key> ... </key>
