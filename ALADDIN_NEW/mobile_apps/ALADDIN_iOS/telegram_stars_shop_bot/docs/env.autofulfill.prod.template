# =============================================================================
# Шаблон автовыдачи Stars/Premium (iStar → Fragment)
# Копировать в /opt/aladdin-telegram-shop-bot/shared/.env
# Включать AUTO_FULFILL_ENABLED=true только после ISTAR_API_KEY и пополнения TON.
# =============================================================================

# --- Мастер и типы (пока false до ключей iStar) ---
AUTO_FULFILL_ENABLED=false
AUTO_FULFILL_STARS_ENABLED=false
AUTO_FULFILL_PREMIUM_ENABLED=false
AUTO_FULFILL_MAX_ORDER_RUB=50000
AUTO_FULFILL_MAX_ATTEMPTS=5
AUTO_FULFILL_POLL_INTERVAL_SECONDS=60
AUTO_FULFILL_FAILURE_ALERTS_ENABLED=true

# --- iStar Partner API ---
# Кабинет (логин): https://istar.fragmentapi.com/
# Документация:     https://istar.fragmentapi.com/docs
# Зеркало/лендинг:  https://fragmentapi.com/  или  https://istar.tg/api
# API (боевой):     https://v1.fragmentapi.com/api/v1/partner
ISTAR_API_KEY=
ISTAR_API_BASE=https://v1.fragmentapi.com/api/v1/partner
ISTAR_WALLET_TYPE=TON
ISTAR_WEBHOOK_SECRET=
# Webhook в кабинете iStar:
# https://aladdin-ai.ru/v1/payments/istar-webhook

# Порог TON на кошельке iStar (0 = не проверять). Рекомендуется 20 после пополнения.
ISTAR_MIN_TON_BALANCE_ALERT=0

# --- Мониторинг очереди ---
STUCK_PAID_ALERT_HOURS=24
STUCK_PAID_CHECK_INTERVAL_SECONDS=3600
STUCK_PROCESSING_ALERT_MINUTES=30
OPERATOR_QUEUE_PROCESSING_IDLE_MINUTES=30

# --- После подстановки ключей ---
# 1) AUTO_FULFILL_ENABLED=true, STARS/PREMIUM=true
# 2) ISTAR_MIN_TON_BALANCE_ALERT=20
# 3) systemctl enable --now auto-fulfill-worker.service
# 4) Смоук: docs/AUTO_FULFILL_SMOKE.md
