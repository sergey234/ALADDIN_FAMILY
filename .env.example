# Скопируйте в `.env` на сервере gateway и задайте значения.
# Зависимости: `pip install -r ../../../requirements.txt` (из корня репозитория ALADDIN_NEW).

# --- Обязательно для JWT ---
JWT_SECRET=change-me-long-random-string
JWT_ALGORITHM=HS256

# --- Apple Push Notification service (HTTP/2, ключ .p8 из Apple Developer) ---
# Положите AuthKey_XXXXXXXXXX.p8 на сервер (права 600), укажите абсолютный путь:
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_PATH=/etc/aladdin/secrets/AuthKey_XXXXXXXXXX.p8
# Bundle ID приложения (совпадает с Xcode → Signing):
APNS_TOPIC=family.aladdin.ios
# Production: false. Sandbox/TestFlight: true
APNS_USE_SANDBOX=false

# --- Привязка push к семье ---
# Access/refresh JWT должны содержать claim `family_id` (уже есть для `/auth/login-by-recovery-code`).
# Клиент iOS дополнительно шлёт `familyId` в теле `POST /api/auth/register-device` из локального `family_id`.
# Если и JWT, и тело задают family_id — они должны совпадать, иначе 422.
