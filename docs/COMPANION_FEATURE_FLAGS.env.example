# Companion Platform — feature flags (VPS /opt/aladdin-backend)
# Скопировать в .env и менять без деплоя iOS.

# P0 — включено по умолчанию
FEATURE_CHAT_CORE=true
FEATURE_VOICE_ENABLED=true
FEATURE_COMPANION_ENABLED=true
FEATURE_TRUST_ENABLED=true
FEATURE_STREAM_RESUME_ENABLED=true
FEATURE_ADULT_APP_ENABLED=true

# P1 — выключено до релиза
FEATURE_MEMORY_ENABLED=false

# P2 — выключено до Phase B
FEATURE_WEB_SEARCH_ENABLED=false
FEATURE_MULTI_AGENT_ENABLED=false
FEATURE_VISION_ENABLED=false

# P3
FEATURE_IMAGE_GEN_ENABLED=false
FEATURE_VIDEO_GEN_ENABLED=false
FEATURE_WORKSPACES_ENABLED=false

# Пример: отключить голос на проде без релиза приложения
# FEATURE_VOICE_ENABLED=false

# SQLite MVP (P0) — путь к БД trust/threads/usage
COMPANION_DB_PATH=/opt/aladdin-backend/data/companion_platform.db
