# Шаблон: скопируйте в FIGMA_ONBOARDING.env и заполните реальными данными из Figma (без выдуманных ключей).
# Как получить URL и file key: FIGMA_LINK_INSTRUCTIONS.md
# Заполненный FIGMA_ONBOARDING.env можно коммитить для внутренней команды.

# Полная ссылка на мастер-файл (страница Onboarding + Main)
FIGMA_MASTER_URL=

# Только ключ файла из URL: figma.com/design/FILE_KEY/...
FIGMA_FILE_KEY=
