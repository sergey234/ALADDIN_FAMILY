[Unit]
Description=ALADDIN Backend API Service (gunicorn :8002)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aladdin-backend
Environment="PATH=/opt/aladdin-backend/venv/bin"
Environment=DISABLE_SFM_MOCK=1
Environment=PYTHONPATH=/opt/aladdin-backend
Environment=ANTIFAKE_UPLOAD_DIR=/var/lib/aladdin/antifake/uploads
ExecStart=/opt/aladdin-backend/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker main:app -b 0.0.0.0:8002
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


