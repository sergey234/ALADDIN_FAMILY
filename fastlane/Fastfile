# Fastfile для ALADDIN iOS CI/CD
# Использует существующие сертификаты и профили из GitHub Secrets
# НЕ требует изменения project.pbxproj

default_platform(:ios)
require "open3"

platform :ios do
  desc "Build archive for App Store with manual signing using existing certificates and profiles"
  lane :build_archive do |options|
    project_root = File.expand_path("..", __dir__)
    Dir.chdir(project_root) do
      puts "📁 Рабочая директория: #{Dir.pwd}"
      puts "📁 Проверка наличия проекта: #{File.exist?('ALADDIN.xcodeproj') ? '✅ найден' : '❌ не найден'}"

      team_id = ENV["APPLE_TEAM_ID"]
      app_profile_uuid = ENV["APP_PROFILE_UUID"]
      extension_profile_uuid = ENV["PROVISIONING_PROFILE_EXTENSION_UUID"]
      antifake_profile_uuid = ENV["PROVISIONING_PROFILE_ANTIFAKE_SHARE_UUID"]
      dist_cert_name = ENV["DIST_CERT_NAME"] || "Apple Distribution"

      puts "🔐 Team ID: #{team_id}"
      puts "🔐 Certificate: #{dist_cert_name}"
      puts "📋 App Profile UUID: #{app_profile_uuid}"
      puts "📋 Content Blocker Profile UUID: #{extension_profile_uuid}"
      puts "📋 Antifake Share Profile UUID: #{antifake_profile_uuid || '(automatic via -allowProvisioningUpdates)'}"

      UI.user_error!("❌ APP_PROFILE_UUID не установлен в окружении") if app_profile_uuid.nil? || app_profile_uuid.empty?
      if extension_profile_uuid.nil? || extension_profile_uuid.empty?
        UI.user_error!("❌ PROVISIONING_PROFILE_EXTENSION_UUID не установлен. Нужен профиль для ALADDINContentBlocker.")
      end

      profile_dir = "#{ENV['HOME']}/Library/MobileDevice/Provisioning Profiles"
      app_profile_file = "#{profile_dir}/#{app_profile_uuid}.mobileprovision"
      extension_profile_file = "#{profile_dir}/#{extension_profile_uuid}.mobileprovision"
      antifake_profile_file = antifake_profile_uuid.to_s.empty? ? nil : "#{profile_dir}/#{antifake_profile_uuid}.mobileprovision"

      expected_app_group = "group.com.aladdin.family"
      validate_profile_app_group = lambda do |profile_path, profile_label, expected_bundle_id|
        unless File.exist?(profile_path)
          UI.user_error!("❌ #{profile_label}: provisioning profile не найден по пути #{profile_path}")
        end

        profile_xml, stderr, status = Open3.capture3("security", "cms", "-D", "-i", profile_path)
        unless status.success?
          UI.user_error!("❌ #{profile_label}: не удалось прочитать provisioning profile. #{stderr}")
        end

        profile_name = profile_xml[/<key>Name<\/key>\s*<string>([^<]+)<\/string>/m, 1] || "unknown"
        application_identifier = profile_xml[/<key>application-identifier<\/key>\s*<string>([^<]+)<\/string>/m, 1] || ""
        has_app_group = profile_xml.include?("<string>#{expected_app_group}</string>")
        puts "📋 #{profile_label} profile: #{profile_name}"
        puts "📋 #{profile_label} application-identifier: #{application_identifier}"
        puts "📋 #{profile_label} App Group #{expected_app_group}: #{has_app_group ? '✅' : '❌'}"

        unless application_identifier.end_with?(".#{expected_bundle_id}")
          UI.user_error!("❌ #{profile_label}: profile '#{profile_name}' не для bundle id #{expected_bundle_id}")
        end
        unless has_app_group
          UI.user_error!("❌ #{profile_label}: profile '#{profile_name}' без App Group #{expected_app_group}")
        end

        profile_name
      end

      app_profile_name = validate_profile_app_group.call(app_profile_file, "App", "family.aladdin.ios")
      extension_profile_name = validate_profile_app_group.call(extension_profile_file, "Content Blocker", "family.aladdin.ios.ALADDINContentBlocker")

      antifake_manual = false
      antifake_profile_name = nil
      if antifake_profile_uuid && !antifake_profile_uuid.empty?
        antifake_profile_name = validate_profile_app_group.call(
          antifake_profile_file,
          "Antifake Share",
          "family.aladdin.ios.ALADDINAntifakeShare"
        )
        antifake_manual = true
      end

      xcconfig_path = "./build/Release.xcconfig"
      sh("mkdir -p ./build")

      antifake_xcconfig = if antifake_manual
        <<~ANTIFAKE
          ALADDINAntifakeShare_CODE_SIGN_IDENTITY = Apple Distribution
          ALADDINAntifakeShare_CODE_SIGN_STYLE = Manual
          ALADDINAntifakeShare_DEVELOPMENT_TEAM = #{team_id}
          ALADDINAntifakeShare_PROVISIONING_PROFILE_SPECIFIER = #{antifake_profile_uuid}
          ALADDINAntifakeShare_PROVISIONING_PROFILE = #{antifake_profile_uuid}
          ALADDINAntifakeShare_PRODUCT_BUNDLE_IDENTIFIER = family.aladdin.ios.ALADDINAntifakeShare
        ANTIFAKE
      else
        <<~ANTIFAKE
          ALADDINAntifakeShare_CODE_SIGN_STYLE = Automatic
          ALADDINAntifakeShare_DEVELOPMENT_TEAM = #{team_id}
          ALADDINAntifakeShare_PROVISIONING_PROFILE_SPECIFIER =
          ALADDINAntifakeShare_PRODUCT_BUNDLE_IDENTIFIER = family.aladdin.ios.ALADDINAntifakeShare
        ANTIFAKE
      end

      xcconfig_content = <<~XCCONFIG
        DEVELOPMENT_TEAM = #{team_id}

        ALADDIN_CODE_SIGN_STYLE = Manual
        ALADDIN_DEVELOPMENT_TEAM = #{team_id}
        ALADDIN_PRODUCT_BUNDLE_IDENTIFIER = family.aladdin.ios
        ALADDIN_PROVISIONING_PROFILE_SPECIFIER = #{app_profile_uuid}
        ALADDIN_PROVISIONING_PROFILE = #{app_profile_uuid}

        ALADDINContentBlocker_CODE_SIGN_STYLE = Manual
        ALADDINContentBlocker_DEVELOPMENT_TEAM = #{team_id}
        ALADDINContentBlocker_PRODUCT_BUNDLE_IDENTIFIER = family.aladdin.ios.ALADDINContentBlocker
        ALADDINContentBlocker_PROVISIONING_PROFILE_SPECIFIER = #{extension_profile_uuid}
        ALADDINContentBlocker_PROVISIONING_PROFILE = #{extension_profile_uuid}

        #{antifake_xcconfig}
      XCCONFIG

      File.write(xcconfig_path, xcconfig_content)
      puts "✅ xcconfig создан: #{xcconfig_path}"

      archive_path = "./build/ALADDIN.xcarchive"
      antifake_sign_flag = antifake_manual ? "ALADDINAntifakeShare_CODE_SIGN_STYLE=Manual" : "ALADDINAntifakeShare_CODE_SIGN_STYLE=Automatic"
      antifake_profile_clear = antifake_manual ? "" : "ALADDINAntifakeShare_PROVISIONING_PROFILE_SPECIFIER="

      api_key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
      api_issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
      api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      if (api_key_path.nil? || api_key_path.empty?) && api_key_id && !api_key_id.empty?
        api_key_path = "#{ENV['HOME']}/.appstoreconnect/private_keys/AuthKey_#{api_key_id}.p8"
      end
      if !antifake_manual && api_key_id && !api_key_id.empty? && api_issuer_id && !api_issuer_id.empty? && api_key_path && File.exist?(api_key_path)
        ENV["APP_STORE_CONNECT_API_KEY_ID"] = api_key_id
        ENV["APP_STORE_CONNECT_ISSUER_ID"] = api_issuer_id
        ENV["APP_STORE_CONNECT_API_KEY_PATH"] = api_key_path
        puts "✅ App Store Connect API key configured for automatic AntifakeShare provisioning"
      elsif !antifake_manual
        puts "⚠️  AntifakeShare automatic signing requires App Store Connect API key (-allowProvisioningUpdates)"
      end

      xcodebuild_args = [
        "xcodebuild", "archive",
        "-project", "ALADDIN.xcodeproj",
        "-scheme", "ALADDIN",
        "-configuration", "Release",
        "-xcconfig", xcconfig_path,
        "-archivePath", archive_path,
        "-destination", "generic/platform=iOS",
        "DEVELOPMENT_TEAM=#{team_id}",
        "ALADDIN_CODE_SIGN_STYLE=Manual",
        "ALADDINContentBlocker_CODE_SIGN_STYLE=Manual",
        antifake_sign_flag
      ]
      if antifake_manual
        xcodebuild_args << "ALADDINAntifakeShare_CODE_SIGN_IDENTITY=Apple Distribution"
        xcodebuild_args << "ALADDINAntifakeShare_PROVISIONING_PROFILE_SPECIFIER=#{antifake_profile_uuid}"
        xcodebuild_args << "ALADDINAntifakeShare_PROVISIONING_PROFILE=#{antifake_profile_uuid}"
      else
        xcodebuild_args << antifake_profile_clear unless antifake_profile_clear.empty?
        xcodebuild_args << "-allowProvisioningUpdates"
      end

      sh(*xcodebuild_args)
      puts "✅ Архив создан: #{archive_path}"
      archive_path
    end
  end

  desc "Export IPA from archive"
  lane :export_ipa do |options|
    archive_path = options[:archive_path] || "./build/ALADDIN.xcarchive"
    export_path = options[:export_path] || "./build/export"
    team_id = ENV["APPLE_TEAM_ID"]
    app_profile_uuid = ENV["APP_PROFILE_UUID"]
    extension_profile_uuid = ENV["PROVISIONING_PROFILE_EXTENSION_UUID"]
    antifake_profile_uuid = ENV["PROVISIONING_PROFILE_ANTIFAKE_SHARE_UUID"]

    UI.user_error!("❌ APP_PROFILE_UUID не установлен") if app_profile_uuid.nil? || app_profile_uuid.empty?
    UI.user_error!("❌ PROVISIONING_PROFILE_EXTENSION_UUID не установлен") if extension_profile_uuid.nil? || extension_profile_uuid.empty?

    profiles = {
      "family.aladdin.ios" => app_profile_uuid,
      "family.aladdin.ios.ALADDINContentBlocker" => extension_profile_uuid
    }
    if antifake_profile_uuid && !antifake_profile_uuid.empty?
      profiles["family.aladdin.ios.ALADDINAntifakeShare"] = antifake_profile_uuid
    end

    export_options_path = "./build/ExportOptions.plist"
    export_options = {
      method: "app-store",
      teamID: team_id,
      signingStyle: "manual",
      provisioningProfiles: profiles
    }

    require "plist"
    File.write(export_options_path, export_options.to_plist)

    sh("xcodebuild -exportArchive",
       "-archivePath #{archive_path}",
       "-exportPath #{export_path}",
       "-exportOptionsPlist #{export_options_path}")

    puts "✅ IPA экспортирован: #{export_path}"
    export_path
  end
end
