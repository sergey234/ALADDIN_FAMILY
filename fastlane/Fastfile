# Fastfile для ALADDIN iOS CI/CD
# Использует существующие сертификаты и профили из GitHub Secrets
# НЕ требует изменения project.pbxproj

default_platform(:ios)

platform :ios do
  desc "Build archive for App Store with manual signing using existing certificates and profiles"
  lane :build_archive do |options|
    # КРИТИЧЕСКИ ВАЖНО: Fastlane запускается из fastlane/ директории
    # Нужно перейти в корень проекта, где находится ALADDIN.xcodeproj
    project_root = File.expand_path("..", __dir__)
    Dir.chdir(project_root) do
      puts "📁 Рабочая директория: #{Dir.pwd}"
      puts "📁 Проверка наличия проекта: #{File.exist?('ALADDIN.xcodeproj') ? '✅ найден' : '❌ не найден'}"
      
      # Переменные окружения из GitHub Secrets (уже установлены в workflow)
      team_id = ENV["APPLE_TEAM_ID"]
      keychain_path = ENV["KEYCHAIN_PATH"]
      keychain_password = ENV["KEYCHAIN_PASSWORD"]
      app_profile_uuid = ENV["APP_PROFILE_UUID"]
      ext_profile_uuid = ENV["EXT_PROFILE_UUID"]
      dist_cert_name = ENV["DIST_CERT_NAME"] || "Apple Distribution"
      
      puts "🔐 Team ID: #{team_id}"
      puts "🔐 Certificate: #{dist_cert_name}"
      puts "📋 App Profile UUID: #{app_profile_uuid}"
      puts "📋 Extension Profile UUID: #{ext_profile_uuid}"
      
      if app_profile_uuid.nil? || app_profile_uuid.empty?
        UI.user_error!("❌ APP_PROFILE_UUID не установлен в окружении")
      end
      
      if ext_profile_uuid.nil? || ext_profile_uuid.empty?
        UI.user_error!("❌ EXT_PROFILE_UUID не установлен в окружении")
      end
      
      # Получить полные пути к профилям (ДО создания xcconfig)
      profile_dir = "#{ENV['HOME']}/Library/MobileDevice/Provisioning Profiles"
      app_profile_file = "#{profile_dir}/#{app_profile_uuid}.mobileprovision"
      ext_profile_file = "#{profile_dir}/#{ext_profile_uuid}.mobileprovision"
      
      puts "📋 Проверка путей к профилям:"
      puts "   App profile: #{app_profile_file} (#{File.exist?(app_profile_file) ? '✅' : '❌'})"
      puts "   Extension profile: #{ext_profile_file} (#{File.exist?(ext_profile_file) ? '✅' : '❌'})"
      
      # Создать xcconfig файл с полными путями
      xcconfig_path = "./build/Release.xcconfig"
      sh("mkdir -p ./build")
      
      xcconfig_content = <<~XCCONFIG
      // Fastlane xcconfig for Manual signing
      // КРИТИЧЕСКИ ВАЖНО: НЕ указываем CODE_SIGN_IDENTITY - Xcode выберет сертификат из профиля автоматически
      // Это позволяет Xcode автоматически выбрать правильный сертификат из provisioning profile
      CODE_SIGN_STYLE = Manual
      DEVELOPMENT_TEAM = #{team_id}
      
      // App target - ПРИНУДИТЕЛЬНО Manual signing
      ALADDIN_CODE_SIGN_STYLE = Manual
      ALADDIN_DEVELOPMENT_TEAM = #{team_id}
      // НЕ указываем ALADDIN_CODE_SIGN_IDENTITY - Xcode выберет из профиля
      ALADDIN_PROVISIONING_PROFILE_SPECIFIER = #{app_profile_uuid}
      ALADDIN_PROVISIONING_PROFILE = #{app_profile_file}
      ALADDIN_PRODUCT_BUNDLE_IDENTIFIER = family.aladdin.ios
      
      // Extension target - ПРИНУДИТЕЛЬНО Manual signing
      ALADDINPacketTunnel_CODE_SIGN_STYLE = Manual
      ALADDINPacketTunnel_DEVELOPMENT_TEAM = #{team_id}
      // НЕ указываем ALADDINPacketTunnel_CODE_SIGN_IDENTITY - Xcode выберет из профиля
      ALADDINPacketTunnel_PROVISIONING_PROFILE_SPECIFIER = #{ext_profile_uuid}
      ALADDINPacketTunnel_PROVISIONING_PROFILE = #{ext_profile_file}
      ALADDINPacketTunnel_PRODUCT_BUNDLE_IDENTIFIER = family.aladdin.ios.packetTunnel
    XCCONFIG
    
      File.write(xcconfig_path, xcconfig_content)
      puts "✅ xcconfig создан: #{xcconfig_path}"
      
      # Собрать архив используя xcodebuild напрямую
      # Fastlane может иметь проблемы с Manual signing, если проект настроен на Automatic
      # Поэтому используем прямой вызов xcodebuild с полными путями к профилям
      archive_path = "./build/ALADDIN.xcarchive"
      
      puts "🔨 Сборка архива с Manual signing через Fastlane..."
      puts "📁 Текущая директория: #{Dir.pwd}"
      puts "📁 Проект существует: #{File.exist?('ALADDIN.xcodeproj') ? '✅' : '❌'}"
      
      xcodebuild_command = [
        "xcodebuild archive",
        "-project ALADDIN.xcodeproj",
        "-scheme ALADDIN",
        "-configuration Release",
        "-xcconfig #{xcconfig_path}",
        "-archivePath #{archive_path}",
        "-destination 'generic/platform=iOS'",
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{team_id}",
        # НЕ указываем CODE_SIGN_IDENTITY - позволим Xcode выбрать сертификат из профиля автоматически
        "ALADDIN_CODE_SIGN_STYLE=Manual",
        "ALADDIN_PROVISIONING_PROFILE_SPECIFIER=#{app_profile_uuid}",
        "ALADDIN_PROVISIONING_PROFILE='#{app_profile_file}'",
        "ALADDINPacketTunnel_CODE_SIGN_STYLE=Manual",
        "ALADDINPacketTunnel_PROVISIONING_PROFILE_SPECIFIER=#{ext_profile_uuid}",
        "ALADDINPacketTunnel_PROVISIONING_PROFILE='#{ext_profile_file}'",
        "-allowProvisioningUpdates"
      ].join(" ")
      
      sh(xcodebuild_command)
      
      puts "✅ Архив создан: #{archive_path}"
      
      # Вернуть путь к архиву
      archive_path
    end
  end
  
  desc "Export IPA from archive"
  lane :export_ipa do |options|
    archive_path = options[:archive_path] || "./build/ALADDIN.xcarchive"
    export_path = options[:export_path] || "./build/export"
    
    team_id = ENV["APPLE_TEAM_ID"]
    
    # Получить UUID профилей
    profile_dir = "#{ENV['HOME']}/Library/MobileDevice/Provisioning Profiles"
    app_profile_uuid = nil
    ext_profile_uuid = nil
    
    Dir.glob("#{profile_dir}/*.mobileprovision").each do |profile_path|
      uuid = sh("security cms -D -i #{profile_path.shellescape} 2>/dev/null | plutil -extract UUID raw -o - - 2>/dev/null || echo ''", log: false).strip
      bundle_id = sh("security cms -D -i #{profile_path.shellescape} 2>/dev/null | plutil -extract Entitlements.application-identifier raw -o - - 2>/dev/null || echo ''", log: false).strip
      
      if bundle_id.include?("family.aladdin.ios.packetTunnel")
        ext_profile_uuid = uuid
      elsif bundle_id.include?("family.aladdin.ios") && !bundle_id.include?("packetTunnel")
        app_profile_uuid = uuid
      end
    end
    
    if app_profile_uuid.nil? || ext_profile_uuid.nil?
      UI.user_error!("❌ Не удалось найти UUID профилей для экспорта")
    end
    
    # Создать ExportOptions.plist
    export_options_path = "./build/ExportOptions.plist"
    export_options = {
      method: "app-store",
      teamID: team_id,
      signingStyle: "manual",
      provisioningProfiles: {
        "family.aladdin.ios" => app_profile_uuid,
        "family.aladdin.ios.packetTunnel" => ext_profile_uuid
      }
    }
    
    require 'plist'
    File.write(export_options_path, export_options.to_plist)
    
    puts "🔨 Экспорт IPA..."
    sh("xcodebuild -exportArchive",
       "-archivePath #{archive_path}",
       "-exportPath #{export_path}",
       "-exportOptionsPlist #{export_options_path}")
    
    puts "✅ IPA экспортирован: #{export_path}"
    export_path
  end
end
