#!/usr/bin/expect -f
# 🚀 ФИНАЛЬНОЕ РАЗВЕРТЫВАНИЕ API GATEWAY на сервер
# Использует expect для автоматического ввода пароля

set timeout 120
set password "Sergio675"
set server "root@149.154.65.180"
set remote_path "/opt/aladdin-backend"
set local_path "/Users/sergejhlystov/ALADDIN_NEW/ALADDIN_NEW/mobile_apps/ALADDIN_iOS"

puts "=========================================="
puts "🚀 ФИНАЛЬНОЕ РАЗВЕРТЫВАНИЕ API GATEWAY"
puts "=========================================="
puts ""
puts "📦 Локальный путь: $local_path"
puts "🌐 Сервер: $server"
puts "📁 Путь на сервере: $remote_path"
puts ""

# ШАГ 1: Создание backup текущей версии
puts "💾 ШАГ 1: Создание backup текущей версии..."
spawn ssh $server "cd $remote_path && if [ -f api_gateway.py ]; then cp api_gateway.py api_gateway_backup_\$(date +%Y%m%d_%H%M%S).py && echo '✅ Backup создан'; else echo '⚠️  api_gateway.py не найден (первое развертывание)'; fi"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

# ШАГ 2: Загрузка api_gateway_complete.py
puts ""
puts "📤 ШАГ 2: Загрузка api_gateway_complete.py..."
spawn scp "$local_path/api_gateway_complete.py" "$server:$remote_path/"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    eof {
        puts "   ✅ api_gateway_complete.py загружен"
    }
}
wait

# ШАГ 3: Загрузка sfm_adapter.py
puts ""
puts "📤 ШАГ 3: Загрузка sfm_adapter.py..."
spawn scp "$local_path/sfm_adapter.py" "$server:$remote_path/"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts "   ✅ sfm_adapter.py загружен"
    }
}
wait

# ШАГ 4: Проверка синтаксиса
puts ""
puts "🔍 ШАГ 4: Проверка синтаксиса Python..."
spawn ssh $server "cd $remote_path && python3 -m py_compile api_gateway_complete.py && echo '✅ Синтаксис API Gateway OK'"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

# ШАГ 5: Проверка импорта SFM Adapter
puts ""
puts "🔍 ШАГ 5: Проверка импорта SFM Adapter..."
spawn ssh $server "cd $remote_path && python3 -c 'from sfm_adapter import sfm_adapter; print(\"✅ SFM Adapter OK\")' 2>&1"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

# ШАГ 6: Замена api_gateway.py
puts ""
puts "🔄 ШАГ 6: Замена api_gateway.py на новую версию..."
spawn ssh $server "cd $remote_path && cp api_gateway_complete.py api_gateway.py && echo '✅ API Gateway заменен'"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

# ШАГ 7: Перезапуск сервиса
puts ""
puts "🔄 ШАГ 7: Перезапуск API Gateway сервиса..."
spawn ssh $server "systemctl restart aladdin-api-gateway 2>/dev/null || systemctl restart aladdin-main-api-gateway 2>/dev/null || echo '⚠️  Сервис не найден - возможно нужно создать systemd unit'"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

# ШАГ 8: Ожидание запуска
puts ""
puts "⏳ ШАГ 8: Ожидание запуска сервиса (10 сек)..."
sleep 10

# ШАГ 9: Проверка статуса сервиса
puts ""
puts "🔍 ШАГ 9: Проверка статуса сервиса..."
spawn ssh $server "systemctl status aladdin-api-gateway --no-pager 2>/dev/null | head -10 || systemctl status aladdin-main-api-gateway --no-pager 2>/dev/null | head -10"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

# ШАГ 10: Тест health endpoint
puts ""
puts "🏥 ШАГ 10: Тест health endpoint..."
spawn ssh $server "curl -s http://localhost:8002/api/health 2>/dev/null | python3 -m json.tool 2>/dev/null || curl -s http://localhost:8002/api/health"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof {
        puts ""
    }
}
wait

puts ""
puts "=========================================="
puts "✅ РАЗВЕРТЫВАНИЕ ЗАВЕРШЕНО!"
puts "=========================================="
puts ""
puts "📝 ПРОВЕРКА:"
puts "   curl http://149.154.65.180/api/health"
puts "   curl https://aladdin-ai.ru/api/health"
puts ""



