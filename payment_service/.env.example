# Payment Service Environment Variables
# Скопируйте этот файл в .env и заполните реальными значениями

# Database
PAYMENT_DATABASE_URL=sqlite+aiosqlite:///./payments.db

# API Keys
PAYMENT_API_KEY_PUBLIC=PUBLIC_CLIENT_KEY
PAYMENT_WEBHOOK_SECRET=WEBHOOK_SECRET_KEY_CHANGE_IN_PRODUCTION
PAYMENT_ADMIN_KEY=ADMIN_SECRET_KEY_CHANGE_IN_PRODUCTION

# Frontend URL
PAYMENT_FRONTEND_URL=http://localhost:8080

# PSP Mock URL
PAYMENT_PSP_MOCK_REDIRECT_URL=https://pay.aladdin.family/mock-checkout

# Rate Limiting
PAYMENT_RATE_LIMIT_RETRIEVE_MAX=5
PAYMENT_RATE_LIMIT_RETRIEVE_WINDOW=60

# Manual Transfer (Оплата на карту через СБП)
# ⚠️ ВАЖНО: Заполните эти поля для работы manual_transfer!
PAYMENT_CARD_NUMBER=2202 2083 0881 3410
# Если нужно скрыть ФИО на странице success.html — оставьте значение пустым
PAYMENT_CARD_HOLDER_NAME=
