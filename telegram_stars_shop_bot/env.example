# Скопируйте в .env и заполните.
BOT_TOKEN=
# @username магазин-бота без @ — для GET /r/{code} на Partner API (vpn-12 → t.me?start=r-{code}).
SHOP_BOT_USERNAME=
ADMIN_IDS=123456789,987654321
# Прод: один файл shop.db вне каталога releases/… (иначе при каждом rsync — новая пустая БД рядом с кодом).
# Пример на сервере: DATABASE_PATH=/opt/aladdin-telegram-shop-bot/data/shop.db
# Локально не задавать — используется путь по умолчанию рядом с кодом бота.
# Опционально: подмножество ADMIN_IDS — «супер-админы» (зачисление топапа, «Оплачен»/«Выдан», завершение выкупа, конкурсы).
# Пусто = все из ADMIN_IDS с полными правами.
SUPER_ADMIN_IDS=

# Канал магазина (бот должен быть администратором канала).
# REQUIRED_CHANNEL_ID: @username публичного канала или -100… для приватного (узнайте через пересланное сообщение боту @getidsbot / сырой JSON).
# REQUIRED_CHANNEL_INVITE_URL: ссылка t.me/+… для кнопки «Подписаться»
# Пока ID задан — жёсткая стена: без подписки /start и /menu не открывают магазин; покупки тоже закрыты.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_INVITE_URL=https://t.me/+xwj4zZo4bNphZjVi
# Если REQUIRED_CHANNEL_INVITE_URL пуст — в тексте оферты подставится OFFICIAL_CHANNEL_INVITE_URL (дефолт ниже).
OFFICIAL_CHANNEL_INVITE_URL=https://t.me/+xwj4zZo4bNphZjVi
# Заголовок экрана подписки (например AIMonkey Stars | Premium). Пусто = «Канал магазина».
REQUIRED_CHANNEL_DISPLAY_NAME=AIMonkey Stars | Premium
# full = hero + «Почему мы» + канал | short = короткий wow+скидки+канал | title_only = минимум.
REQUIRED_CHANNEL_GATE_MARKETING=short
# Видимость карточек в главном меню (false = скрыть карточку, код и роуты остаются).
UI_SHOW_API=true
UI_SHOW_PARTNERS=true
UI_SHOW_RECEIPTS=true
# VPN (Shop): карточка «🌐 VPN» в главном меню и команда /vpn. На проде обычно true при готовом VPN API.
UI_SHOW_VPN=false
# URL внутреннего aladdin-shop-vpn-api (часто http://127.0.0.1:<port> на том же хосте, что бот).
VPN_API_BASE_URL=
# Общий секрет HMAC/JWT между ботом/partner_api и VPN-API (не коммитить реальное значение).
VPN_API_HMAC_SECRET=
# vpn-25: circuit breaker и ретраи HTTP к vpn-api (in-process).
VPN_API_CIRCUIT_FAILURE_THRESHOLD=5
VPN_API_CIRCUIT_FAILURE_WINDOW_SECONDS=120
VPN_API_CIRCUIT_OPEN_SECONDS=60
VPN_API_HTTP_MAX_RETRIES=2
# Публичные markdown VPN (HTTPS, тот же хост что и магазин). Без завершающего слэша.
VPN_DOCS_PUBLIC_BASE=https://aladdin-ai.ru/v1/legal
# Происхождение для текстовых ссылок на /sub/… в боте.
VPN_PUBLIC_HTTPS_ORIGIN=https://aladdin-ai.ru
# Кнопка «Новости» в VPN: пусто = REQUIRED_CHANNEL_INVITE_URL, иначе OFFICIAL_CHANNEL_INVITE_URL (отдельный канал статуса — задайте явно).
VPN_NEWS_CHANNEL_URL=
# Опционально: HTTPS-страница о VPN (кнопка в маркетинг-блоке; не Web App).
VPN_MARKETING_LANDING_URL=
# Хаб длинных инструкций (как Teletype у конкурентов): iOS/Android/TV/… Пусто = для кнопки используется VPN_MARKETING_LANDING_URL.
# Хаб инструкций (кнопка «Инструкция на сайте» в разделе AiMonkeyVPN).
VPN_INSTRUCTIONS_URL=https://aladdin-ai.ru/v1/legal/vpn-instructions
# JSON: список строк «локации» для бота (свёрнуть/развернуть). Пусто = встроенный MVP. Формат: docs/VPN_LOCATIONS_JSON.md
VPN_LOCATIONS_JSON=
VPN_LOCATIONS_PREVIEW_N=3
# true = список локаций тянуть из VPN API GET /internal/v1/locations/catalog (тот же VPN_LOCATIONS_JSON на сервере vpn-api).
VPN_LOCATIONS_FROM_API=false

# VPN-рефералка (дни на paid_until через VPN API после первой выданной VPN-покупки приглашённого; см. vpn_referral_* в коде).
VPN_REFERRAL_REFERRER_DAYS=14
VPN_REFERRAL_FRIEND_DAYS=7
# Путь к vpn.db для блока «VPN control plane» в /admin и команд /admin_vpn_status (тот же хост, что бот). Пусто = блок/команда статуса скрыты.
VPN_DB_PATH=
# После оплаты VPN: автоматически прислать .conf в Telegram (poll wg/conf до 120 с).
VPN_AUTO_SEND_WG_AFTER_PAID=true
# После авто-📥 прислать 📷 QR (тот же .conf).
VPN_AUTO_SEND_QR_AFTER_PAID=true
VPN_PROVISION_DELIVERY_TIMEOUT_SECONDS=120
VPN_PROVISION_DELIVERY_POLL_SECONDS=3
# Фон: health VPN API + vpn.db → алерт админам (сек). 300 = каждые 5 мин. 0 = выкл.
# Напоминания об окончании VPN (1 проход в сутки по умолчанию = 86400 с).
VPN_EXPIRY_NOTIFY_ENABLED=true
VPN_EXPIRY_NOTIFY_INTERVAL_SECONDS=86400

VPN_OPS_HEALTH_INTERVAL_SECONDS=300
VPN_OPS_HEALTH_STALE_JOB_MINUTES=10
VPN_OPS_HEALTH_PROVISIONING_WARN_THRESHOLD=5
# Фон: повтор add-subscription-days при недоступном VPN API (секунды между проходами). 0 = выключено.
VPN_REFERRAL_API_RETRY_INTERVAL_SECONDS=300
VPN_REFERRAL_API_MAX_ATTEMPTS_PER_SIDE=12

# Анти-спам: интервал между /start (сек.) и между подтверждениями заказа; TTL капчи на чек-ауте после успеха.
START_COMMAND_MIN_INTERVAL_SECONDS=2
ORDER_CREATE_MIN_INTERVAL_SECONDS=3
CHECKOUT_CAPTCHA_TTL_SECONDS=900

# База: ₽ за 1 USD — обязательна (бот и Partner API не стартуют при 0 или отсутствии).
# Базовый курс для прайса (₽ за 1 USD). Можно фиксировать вручную или обновлять автоматом по схеме ЦБ+5.
# Авто-обновление см. docs/FX_RATES_RUNBOOK.md (fx-rate-sync.service/timer).
USD_RUB_RATE=80

# --- Ориентир USDT в текстах чек-аута (пересчёт из ₽) ---
# Рекомендуется 0: тогда ориентир USDT считается по тому же курсу, что и прайс в ₽ (USD_RUB_RATE) — без расхождений.
# Если задать число > 0 — будет использовано отдельно от USD_RUB_RATE (только для подсказки USDT в UI и fallback в crypto_pay_api).
USDT_RUB_RATE=0

# Реферальные проценты (можно менять без правки кода, если добавите чтение в config).
REF_BUYER_FIRST_ORDER_DISCOUNT_PERCENT=10
REF_REFERRER_COMMISSION_FIRST_ORDER_PERCENT=15

# Админ-дашборд: комиссия платёжки (% от суммы оплаты) и доля каталожного USD для оценки себестоимости Fragment (0..1).
PAYMENT_GATEWAY_FEE_PERCENT=3
AUTO_COGS_USD_FRACTION=0.85

# Опт на Stars от N звёзд в одной позиции.
STARS_WHOLESALE_THRESHOLD=500
STARS_WHOLESALE_DISCOUNT_PERCENT=5

# =============================================================================
# ПРОД: крипто + авто paid — кратко (полный чеклист: docs/CRYPTO_PAY_SPEC.md §0)
# Файл на сервере: shared/.env (не в git), тот же EnvironmentFile для bot + partner_api.
#   CRYPTO_PAY_ENABLED=true  +  CRYPTO_PAY_API_TOKEN=   (токен Crypto Pay, НЕ BOT_TOKEN)
#   XROCKET_PAY_ENABLED=true +  XROCKET_PAY_API_KEY=    (Rocket-Pay-Key)
#   USDT_RUB_RATE=0 (рекомендуется) или явный курс; актуальный USD_RUB_RATE
# Вебхуки в кабинетах → тот же публичный хост, что у Partner API:
#   POST https://ВАШ_ДОМЕН/v1/payments/crypto-pay-webhook
#   POST https://ВАШ_ДОМЕН/v1/payments/xrocket-webhook
# После правок: systemctl restart aladdin-partner-api.service
# =============================================================================

# Крипто-реквизиты (ручной перевод, если не настроены Crypto Pay / xRocket).
# Только USDT в сети TRC20. TON в ручном блоке — по умолчанию показан; отключите CRYPTO_SHOW_TON_MANUAL=false при необходимости.
# Адрес USDT в сети Tron (TRC20), начинается с T… — для ручного блока в боте.
# Если включены Crypto Pay и xRocket и счёт создаётся — покупатель идёт по ссылке в Telegram; это поле тогда запасной путь или режим без провайдеров.
CRYPTO_USDT_TRC20=
CRYPTO_TON=
CRYPTO_SHOW_TON_MANUAL=true

# =============================================================================
# Crypto Pay (Telegram @CryptoBot) — счёт через API; см. docs/CRYPTO_PAY_SPEC.md
# =============================================================================
# Пока false — без createInvoice; остаётся ручной блок CRYPTO_USDT_TRC20 (и опционально TON).
CRYPTO_PAY_ENABLED=false
# API-токен приложения Crypto Pay (НЕ BOT_TOKEN вида 123456:AA… — это другой секрет!).
# Получение: @CryptoBot → Crypto Pay → Create App → команда /pay; testnet: @CryptoTestnetBot.
CRYPTO_PAY_API_TOKEN=
# true = API https://testnet-pay.crypt.bot ; false = https://pay.crypt.bot
CRYPTO_PAY_TESTNET=false
# Опционально: только hostname (testnet-pay.crypt.bot) или полный https://… если нужен нестандартный endpoint.
CRYPTO_PAY_API_HOST=
# Устарело для магазина: счёт всегда в USDT (TRC20). Иное значение игнорируется с предупреждением в логах.
CRYPTO_PAY_DEFAULT_ASSET=USDT
# Срок жизни счёта в Crypto Pay (секунды); согласуйте с ORDER_PENDING_PAYMENT_EXPIRE_MINUTES.
CRYPTO_PAY_INVOICE_EXPIRE_SECONDS=3600
# Опционально: после оплаты — кнопка «открыть бота» (официальный магазин: https://t.me/AiMonkeyStars_bot).
CRYPTO_PAY_PAID_BTN_URL=
# Если ни Crypto Pay, ни xRocket не выдали ссылку: true = показать ручной блок из .env (для отладки). В проде обычно false.
CRYPTO_PAY_WALLET_FALLBACK=false
#
# Вебхук оплаты (Partner API, публичный HTTPS). В приложении Crypto Pay укажите URL:
#   POST https://ВАШ_ДОМЕН/v1/payments/crypto-pay-webhook
# Подпись: заголовок crypto-pay-api-signature = hex(HMAC-SHA256(SHA256(CRYPTO_PAY_API_TOKEN), сырое тело запроса)).
# После успешного вызова заказ pending_payment → paid (идемпотентность по cryptobot:<invoice_id>).

# =============================================================================
# xRocket Pay — второй счёт USDT (TRC20); https://docs.xrocket.tg/api/pay/pay-api-overview
# =============================================================================
XROCKET_PAY_ENABLED=false
# Rocket-Pay-Key из кабинета xRocket (Rocket Pay → API Token). Не путать с CRYPTO_PAY_API_TOKEN.
XROCKET_PAY_API_KEY=
# База API (prod): https://pay.xrocket.exchange
XROCKET_PAY_API_BASE=https://pay.xrocket.exchange
#
# Вебхук оплаты в настройках приложения xRocket (Rocket Pay):
#   POST https://ВАШ_ДОМЕН/v1/payments/xrocket-webhook
# Подпись: заголовок rocket-pay-signature = hex(HMAC-SHA256(SHA256(XROCKET_PAY_API_KEY), UTF-8 тело)) — как в xrocket-pay-api-sdk.
# Идемпотентность: xrocket:<id счёта из поля data.id>.

# =============================================================================
# Автовыдача Stars / Premium после «Оплачен» (iStar) — чеклист выхода в прод
# =============================================================================
# 1) Заведите ключи iStar, пропишите ISTAR_* ниже и вебхук: POST https://ВАШ_ДОМЕН/v1/payments/istar-webhook
# 2) Включите глобально и по типу товара, затем поднимите воркер (systemd unit: docs/auto-fulfill-worker.service), например:
#    /opt/.../venv/bin/python3 -m partner_api.auto_fulfill_worker --forever --limit 10
# 3) AUTO_FULFILL_MAX_ORDER_RUB — лимит безопасности: заказы дороже (₽) не идут в авто, только вручную. 0 = без лимита.
# Полная схема: docs/IMPLEMENTATION_PLAN_AND_TASKS.md п.37.
#
# Прод-шаблон (подставьте ключи, проверьте воркер и вебхук iStar, затем включайте):
# AUTO_FULFILL_ENABLED=true
# AUTO_FULFILL_STARS_ENABLED=true
# AUTO_FULFILL_PREMIUM_ENABLED=true
# AUTO_FULFILL_MAX_ORDER_RUB=50000
AUTO_FULFILL_ENABLED=false
AUTO_FULFILL_STARS_ENABLED=false
AUTO_FULFILL_PREMIUM_ENABLED=false
AUTO_FULFILL_MAX_ORDER_RUB=0
AUTO_FULFILL_MAX_ATTEMPTS=5
AUTO_FULFILL_POLL_INTERVAL_SECONDS=60
AUTO_FULFILL_FAILURE_ALERTS_ENABLED=true
#
# iStar partner API — обязателен для авто-выдачи Stars/Premium. Док: https://istar.fragmentapi.com/docs
ISTAR_API_KEY=
ISTAR_API_BASE=https://v1.fragmentapi.com/api/v1/partner
ISTAR_WALLET_TYPE=TON
ISTAR_WEBHOOK_SECRET=
# URL тот же хост, что и Partner API, путь: /v1/payments/istar-webhook

# =============================================================================
# Partner API — rate limit (окно 60 с, на процесс; 0 = выключить класс лимита)
# =============================================================================
# Лимит для /v1 с заголовком X-API-KEY (хэш ключа + IP).
PARTNER_API_RATE_LIMIT_API_PER_MINUTE=120
# Лимит для путей вебхуков оплаты (Ckassa, LAVA, Crypto Pay, xRocket, provider, iStar) по IP.
PARTNER_API_RATE_LIMIT_WEBHOOK_PER_MINUTE=90
# Лимит для /health, /docs, /openapi.json по IP.
PARTNER_API_RATE_LIMIT_PUBLIC_PER_MINUTE=400
# backend хранилища лимитов: memory|redis (redis нужен при нескольких репликах API).
PARTNER_API_RATE_LIMIT_BACKEND=memory
# Redis (опционально; при backend=redis). Можно URL или host/port/db/password.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Бот: мониторинг заказов paid/processing без обновления (лог WARNING)
# =============================================================================
# 0 = не запускать фоновый цикл. Иначе — искать заказы, у которых updated_at старше N часов.
STUCK_PAID_ALERT_HOURS=24
STUCK_PAID_CHECK_INTERVAL_SECONDS=3600
# Только processing без обновления дольше N минут — отдельный ops-алерт (0 = не проверять).
STUCK_PROCESSING_ALERT_MINUTES=0
# Порог «долго в работе» для команды /admqueue (операторский список).
OPERATOR_QUEUE_PROCESSING_IDLE_MINUTES=30

# Break-glass отчёт и порог «вторые глаза» (adm:paidbg). 0 = выключить/не применять.
BREAK_GLASS_REPORT_INTERVAL_SECONDS=86400
BREAK_GLASS_REPORT_LOOKBACK_HOURS=24
BREAK_GLASS_TWO_EYES_THRESHOLD_RUB=0

# Минимальный интервал между повторными запросами счёта LAVA / Crypto Pay для одного order_id (0 = выкл.).
PAYMENT_CHECKOUT_INVOICE_COOLDOWN_SECONDS=45

# =============================================================================
# LAVA Business — фиат (в т.ч. СБП) на стороне LAVA: https://lava.ru | API: https://dev.lava.ru/
# =============================================================================
# Куда «приходят деньги» с точки зрения магазина: на расчёты с LAVA по вашему договору — реквизиты юрлица/ИП и вывод
# средств настраиваются только в личном кабинете LAVA, не в этом файле. Здесь — лишь API-магазин + вебхук для бота.
# В кабинете LAVA: ID проекта (shop) и секретный ключ для подписи запросов invoice/create.
LAVA_SHOP_ID=
LAVA_SECRET_KEY=
#
# «Дополнительный ключ» из кабинета LAVA — для проверки вебхука (заголовок Authorization = HMAC-SHA256
# от сырого JSON-тела запроса; см. https://dev.lava.ru/api-invoice-sign ).
LAVA_WEBHOOK_ADDITIONAL_SECRET=
#
# Публичный HTTPS URL вашего Partner API, куда LAVA пришлёт POST после оплаты. Должен быть доступен из интернета.
# Путь в нашем коде: POST {LAVA_HOOK_URL}  →  обычно: https://ВАШ_ДОМЕН/v1/payments/lava-webhook
LAVA_HOOK_URL=
#
# Опционально:
# LAVA_API_BASE=https://api.lava.ru/business/   (если пусто — используется это значение по умолчанию)
# LAVA_SUCCESS_URL=https://t.me/ВашБот         (редирект после успешной оплаты на странице LAVA)
# LAVA_FAIL_URL=https://t.me/ВашБот
LAVA_INVOICE_EXPIRE_MINUTES=720
#
# Методы на странице оплаты LAVA (service_id через запятую). Пустая строка = показать все методы, доступные проекту.
# СБП: укажите sbp (если СБП включён для вашего магазина в LAVA — тогда кнопка/метод СБП будет на странице счёта).
# Пример только карта + СБП:
LAVA_INCLUDE_SERVICES=card,sbp

# =============================================================================
# Cardlink — фиат ₽ (карта / СБП): https://cardlink.link | API: https://cardlink.link/reference/api
# =============================================================================
# В ЛК Cardlink при создании проекта (поля должны совпадать с дефолтами ниже):
#   Название: AIMonkey Stars | Premium
#   Категория: Цифровые товары и услуги
#   Домен: aladdin-ai.ru
#   Success URL:  https://aladdin-ai.ru/v1/payment/success
#   Fail URL:     https://aladdin-ai.ru/v1/payment/fail
#   Result URL:   https://aladdin-ai.ru/v1/payments/cardlink-webhook
#   Refund URL:   https://aladdin-ai.ru/v1/payments/cardlink-refund
#   Chargeback:   https://aladdin-ai.ru/v1/payments/cardlink-chargeback
# После модерации: Shop ID + API token из кабинета → CARDLINK_SHOP_ID / CARDLINK_API_TOKEN.
CARDLINK_ENABLED=false
CARDLINK_SHOP_ID=
CARDLINK_API_TOKEN=
# CARDLINK_API_BASE=https://cardlink.link
# URL в ЛК Cardlink (дефолты совпадают с формой проекта):
# CARDLINK_SUCCESS_URL=https://aladdin-ai.ru/v1/payment/success
# CARDLINK_FAIL_URL=https://aladdin-ai.ru/v1/payment/fail
# CARDLINK_HOOK_URL=https://aladdin-ai.ru/v1/payments/cardlink-webhook
# CARDLINK_REFUND_URL=https://aladdin-ai.ru/v1/payments/cardlink-refund
# CARDLINK_CHARGEBACK_URL=https://aladdin-ai.ru/v1/payments/cardlink-chargeback
CARDLINK_CURRENCY_IN=RUB
CARDLINK_LOCALE=ru
CARDLINK_BILL_TTL_SECONDS=43200
CARDLINK_PAYER_PAYS_COMMISSION=1
# BANK_CARD | SBP | пусто = выбор на форме Cardlink
# CARDLINK_PAYMENT_METHOD=
CARDLINK_PAYMENT_NAME=AIMonkey Stars | Premium
CARDLINK_RETURN_BOT_URL=https://t.me/AiMonkeyStars_bot

# =============================================================================
# Ckassa (ЦК) — боевой фиат ₽: карта, СБП, SberPay на форме оплаты; чек 54-ФЗ
# =============================================================================
# ПРОД: CKASSA_ENABLED=true, CKASSA_TEST_MODE=false, ShopToken + SecKey из ЛК/письма, cbUrl = публичный HTTPS.
# API как у WooCommerce Ckassa: POST https://api2.ckassa.ru/api-shop/rs/wordpress/do-pay/anonymous + server callback.
# Подключение/тариф: https://ckassa.com и support@ckassa.ru
#
# CKASSA_TEST_MODE: только false в проде. true = демо-шлюз (demo-api2) и встроенные демо-ключи, не для настоящих платежей.
# При true бот и Partner API пишут WARNING в лог (см. bot.log / partner_api.log).
CKASSA_ENABLED=false
CKASSA_TEST_MODE=false
CKASSA_SHOP_TOKEN=
CKASSA_SECRET_KEY=
# Обязателен для боя: тот же хост, что Nginx/HTTPS для магазина, путь фиксирован:
#   https://ВАШ_ДОМЕН/v1/payments/ckassa-webhook
# Передаётся в запрос Ckassa как cbUrl, чтобы банк уведомил бот.
CKASSA_CALLBACK_PUBLIC_URL=
# Редирект покупателя после оплаты (часто deep link в бота, например: https://t.me/YourShopBot?start=payok)
CKASSA_SUCCESS_URL=
CKASSA_FAIL_URL=
# Опционально переопределить do-pay (по умолчанию prod URL выше; при тест-режиме — demo-URL).
CKASSA_DO_PAY_URL=
CKASSA_COUNTRY=RU
CKASSA_LANGUAGE=RU
CKASSA_HTTP_TIMEOUT_SECONDS=15
# Фискализация: e-mail/телефон/ФИО плательщика для чека (если пусто — плейсхолдеры; для магазина укажите рабочий support@)
CKASSA_DEFAULT_EMAIL=
CKASSA_DEFAULT_PHONE=+79990000000
CKASSA_DEFAULT_FIO=Покупатель Telegram
CKASSA_RECEIPT_TAXATION=usn_income
CKASSA_RECEIPT_TAX=none
CKASSA_RECEIPT_PAYMENT_METHOD=full_prepayment
CKASSA_RECEIPT_PAYMENT_OBJECT=service
#
# Постоянная ссылка Ckassa «произвольная сумма» (из личного кабинета Ckassa Market). Пустая строка = дефолт бота (bc.ckassa.ru/u6lfph2p6e).
# На шаге «карта / СБП»: при SOLO=true только эта ссылка; при false — плюс счёт Shop API и LAVA, если настроены.
# Авто-«Оплачен» по webhook для универсальной bc-страницы обычно не приходит — сверка по ORDER{id} / поддержка.
CKASSA_BC_UNIVERSAL_PAYMENT_URL=https://bc.ckassa.ru/u6lfph2p6e
# true = на шаге ₽ только ссылка bc (Stars/Premium на себя и в подарок — одна кнопка на оплату). false = параллельно API Ckassa/LAVA.
CKASSA_BC_SOLO_CHECKOUT=true
# Подсказка в тексте бота: типичный минимум платежа на универсальной странице (₽). Не блокирует заказ в коде.
CKASSA_BC_DISPLAY_MIN_RUB=50
# Показывать LAVA одновременно со счётом Ckassa Shop API, даже если универсальная ссылка не задана (два счёта на заказ).
# По умолчанию false: LAVA остаётся запасом, если Ckassa API не открылся.
FIAT_PARALLEL_CKASSA_AND_LAVA=false
# Интервал между повторными нажатиями «Я оплатил (универсальная страница)» (секунды), чтобы не спамить админов.
BC_PAYMENT_CLAIM_COOLDOWN_SECONDS=900

# Авто-истечение заказов «ожидает оплаты» (бот переводит в «срок оплаты истёк» и пишет пользователю).
# Обычно совпадает с LAVA_INVOICE_EXPIRE_MINUTES. 0 = выключить авто-истечение.
ORDER_PENDING_PAYMENT_EXPIRE_MINUTES=720
# Как часто проверять БД (секунды), пока запущен polling бота.
ORDER_PENDING_PAYMENT_SWEEP_INTERVAL_SECONDS=180

# Редирект после оплаты (если не используете LAVA success URL).
PAYMENT_YOOKASSA_RETURN_URL=https://t.me/your_bot

# Поддержка: полная ссылка (приоритет) или username без @ для https://t.me/...
SUPPORT_URL=
SUPPORT_USERNAME=
API_DOCS_URL=

# Юридические страницы: тексты в каталоге legal/*.txt, отдаются Partner API как HTML (/v1/legal/privacy, /v1/legal/terms). На проде nginx обычно проксирует префикс /v1 на :8090.
PRIVACY_POLICY_URL=https://aladdin-ai.ru/v1/legal/privacy
TERMS_OF_SERVICE_URL=https://aladdin-ai.ru/v1/legal/terms
PUBLIC_OFFER_URL=https://aladdin-ai.ru/v1/legal/offer
REFUND_POLICY_URL=https://aladdin-ai.ru/v1/legal/refund
NEWS_CHANNEL_PAGE_URL=https://aladdin-ai.ru/news.html

# Partner HTTP API (отдельный процесс: python -m partner_api.main)
# Случайная длинная строка; без неё выпуск ключа в боте и старт API не работают.
API_KEY_PEPPER=
# Опционально: CORS origins через запятую для браузерных интеграций (лучше пусто — только server-to-server).
PARTNER_API_CORS_ORIGINS=

# Маркетинг «до N %» (отображение на /start; согласуйте с реальными акциями).
MARKETING_MAX_DISCOUNT_PERCENT=47

# Выкуп Stars (заявка «Продать»): ₽ за 100 ⭐ и лимиты.
SELL_OFFER_RUB_PER_100_STARS=750
SELL_MIN_STARS=100
SELL_MAX_STARS=50000

# Пополнение баланса (бот + Partner API): сумма и антифрод. 0 у *_MAX_* / MAX_PENDING_* = без лимита.
TOPUP_MIN_RUB=100
TOPUP_MAX_RUB=500000
TOPUP_MAX_PENDING_PER_USER=8
TOPUP_MIN_INTERVAL_SECONDS=60
# Заказы со статусом «ожидает оплаты» на одного пользователя (бот + API).
MAX_PENDING_PAYMENT_ORDERS_PER_USER=15

# Опционально: file_id картинки для первого экрана /start и для шага «Выберите язык» (тот же file_id).
START_PHOTO_FILE_ID=
# Опционально: file_id картинки для второго экрана онбординга («Почему выбирают нас»).
START_PHOTO_FILE_ID_2=

# Sentry (опционально). DSN не коммитить.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# OPS alerts (Telegram/PagerDuty). false = только логи.
ALERTS_ENABLED=false
# Рекомендуется отдельный бот/чат для дежурной смены.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Опционально: PagerDuty Events API v2 routing key.
PAGERDUTY_ROUTING_KEY=
# Дедуп окна для одинакового dedupe_key.
ALERT_COOLDOWN_SECONDS=300
#
# Ops watchdog (проверка сервисов/health/log burst + heartbeat).
OPS_WATCHDOG_ENABLED=false
OPS_WATCHDOG_LOG_SCAN_LINES=300
OPS_WATCHDOG_ERROR_BURST_THRESHOLD=5
OPS_WATCHDOG_WEBHOOK_BACKLOG_WARN=50
# Heartbeat "всё ок" каждые 30 минут.
OPS_HEARTBEAT_INTERVAL_SECONDS=1800
# KPI checks (split-core) в watchdog; 0 = выключить KPI-блок.
OPS_WATCHDOG_KPI_DAYS=7
# Payment success alert: paid/create (%), только если created >= threshold.
OPS_ALERT_PAYMENT_SUCCESS_MIN_PCT=85
OPS_ALERT_PAYMENT_MIN_CREATED_ORDERS=20
# Webhook SLA alert: success-rate минимум, p95 latency максимум, только если events >= threshold.
OPS_ALERT_WEBHOOK_SUCCESS_MIN_PCT=95
OPS_ALERT_WEBHOOK_P95_MAX_SEC=60
OPS_ALERT_WEBHOOK_MIN_EVENTS=20
# Retention D7 alert: только если размер когорты достаточен.
OPS_ALERT_RETENTION_D7_MIN_PCT=8
OPS_ALERT_RETENTION_MIN_COHORT=30
# CAC alert (<=0 выключает): срабатывает только если paid_users >= threshold.
OPS_ALERT_CAC_MAX_RUB=0
OPS_ALERT_CAC_MIN_PAID_USERS=5
# Weekly executive report (top-10 KPI) в Telegram админам.
EXEC_REPORT_ENABLED=false
EXEC_REPORT_INTERVAL_SECONDS=604800
EXEC_REPORT_DAYS_SHORT=7
EXEC_REPORT_DAYS_LONG=30
# NPS/CSAT survey automation
FEEDBACK_SURVEY_ENABLED=false
FEEDBACK_SURVEY_INTERVAL_SECONDS=21600
FEEDBACK_SURVEY_COOLDOWN_DAYS=30
FEEDBACK_SURVEY_LOOKBACK_DAYS=45
FEEDBACK_SURVEY_BATCH_SIZE=50
# Feature flags (staged rollout)
FEATURE_SPLIT_METRICS_ENABLED=true
FEATURE_FEEDBACK_METRICS_ENABLED=true
FEATURE_FEEDBACK_COLLECTION_ENABLED=true
# Data quality checks (metrics layer)
DATA_QUALITY_CHECKS_ENABLED=false
DATA_QUALITY_CHECKS_INTERVAL_SECONDS=21600
DATA_QUALITY_LOOKBACK_DAYS=7
DATA_QUALITY_MAX_ORDERS_MISSING_KIND=0
DATA_QUALITY_MAX_ORDERS_MISSING_PROFIT_SNAPSHOT=0
DATA_QUALITY_MIN_EVENT_SCHEMA_V2_PCT=95
DATA_QUALITY_MAX_UNATTRIBUTED_PAID_PCT=20

# =============================================================================
# Универсальный вебхук «заказ оплачен» (свой оркестратор; не LAVA — LAVA шлёт свой вебхук на /lava-webhook)
# =============================================================================
# Длинная случайная строка. Без неё POST /v1/payments/provider-webhook отвечает 503.
# Подпись: hex HMAC-SHA256(PAYMENT_WEBHOOK_SECRET, raw_json_bytes), заголовок X-Payment-Signature: sha256=<hex>
# или просто <hex>.
#
# Пример тела JSON:
#   {"idempotency_key":"уникальная-строка-8-128","order_id":123,"action":"mark_paid"}
#
# Пример URL (после деплоя Partner API на порт 8090 за HTTPS-прокси):
#   POST https://ВАШ_ДОМЕН/v1/payments/provider-webhook
PAYMENT_WEBHOOK_SECRET=

# Эксплуатация: см. docs/RUNBOOK.md и docs/ACCEPTANCE_CHECKLIST.md
