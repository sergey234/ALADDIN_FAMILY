# Скопируйте в .env и заполните.
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Канал магазина (бот должен быть администратором канала).
# REQUIRED_CHANNEL_ID: @username или -100…
# REQUIRED_CHANNEL_INVITE_URL: ссылка t.me/… для кнопки «Подписаться»
# Пока ID задан — без подписки недоступны покупки Stars/Premium/подарков и вход в /menu.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_INVITE_URL=

# База: USD -> RUB для отображения (обновляйте вручную или подключите API курсов).
USD_RUB_RATE=97.5

# --- Ориентиры для пользователя (₽ остаётся основной валютой расчёта в боте) ---
# USDT: точный пересчёт из суммы в ₽ по курсу ниже (если 0 — берётся USD_RUB_RATE).
USDT_RUB_RATE=0
# UAH/BYN: приблизительно, через «сколько UAH/BYN за 1 USD» и ваш USD_RUB_RATE (0 = не показывать строку).
DISPLAY_USD_UAH_RATE=0
DISPLAY_USD_BYN_RATE=0

# Реферальные проценты (можно менять без правки кода, если добавите чтение в config).
REF_BUYER_FIRST_ORDER_DISCOUNT_PERCENT=7
REF_REFERRER_COMMISSION_FIRST_ORDER_PERCENT=15

# Опт на Stars от N звёзд в одной позиции.
STARS_WHOLESALE_THRESHOLD=500
STARS_WHOLESALE_DISCOUNT_PERCENT=5

# Крипто-реквизиты (показываются пользователю кнопкой «Крипта»).
CRYPTO_USDT_TRC20=
CRYPTO_TON=

# =============================================================================
# LAVA Business — фиат (в т.ч. СБП) на стороне LAVA: https://lava.ru | API: https://dev.lava.ru/
# =============================================================================
# В кабинете LAVA: ID проекта (shop) и секретный ключ для подписи запросов invoice/create.
LAVA_SHOP_ID=
LAVA_SECRET_KEY=
#
# «Дополнительный ключ» из кабинета LAVA — для проверки вебхука (заголовок Authorization = HMAC-SHA256
# от сырого JSON-тела запроса; см. https://dev.lava.ru/api-invoice-sign ).
LAVA_WEBHOOK_ADDITIONAL_SECRET=
#
# Публичный HTTPS URL вашего Partner API, куда LAVA пришлёт POST после оплаты. Должен быть доступен из интернета.
# Путь в нашем коде: POST {LAVA_HOOK_URL}  →  обычно: https://ВАШ_ДОМЕН/v1/payments/lava-webhook
LAVA_HOOK_URL=
#
# Опционально:
# LAVA_API_BASE=https://api.lava.ru/business/   (если пусто — используется это значение по умолчанию)
# LAVA_SUCCESS_URL=https://t.me/ВашБот         (редирект после успешной оплаты на странице LAVA)
# LAVA_FAIL_URL=https://t.me/ВашБот
LAVA_INVOICE_EXPIRE_MINUTES=720
#
# Методы на странице оплаты LAVA (service_id через запятую). Пустая строка = показать все методы, доступные проекту.
# СБП: укажите sbp (если СБП включён для вашего магазина в LAVA — тогда кнопка/метод СБП будет на странице счёта).
# Пример только карта + СБП:
LAVA_INCLUDE_SERVICES=card,sbp

# Редирект после оплаты (если не используете LAVA success URL).
PAYMENT_YOOKASSA_RETURN_URL=https://t.me/your_bot

# Поддержка: полная ссылка (приоритет) или username без @ для https://t.me/...
SUPPORT_URL=
SUPPORT_USERNAME=
API_DOCS_URL=

# Публичные юридические страницы (Telegraph и др.). По умолчанию — типовые шаблоны; замените на свои URL или оставьте пустым, чтобы скрыть URL-кнопки в разделе «Поддержка».
PRIVACY_POLICY_URL=https://telegra.ph/Politika-konfidencialnosti-03-24-56
TERMS_OF_SERVICE_URL=https://telegra.ph/Polzovatelskoe-soglashenie-03-24-40

# Partner HTTP API (отдельный процесс: python -m partner_api.main)
# Случайная длинная строка; без неё выпуск ключа в боте и старт API не работают.
API_KEY_PEPPER=
# Опционально: CORS origins через запятую для браузерных интеграций (лучше пусто — только server-to-server).
PARTNER_API_CORS_ORIGINS=

# Маркетинг «до N %» (отображение на /start; согласуйте с реальными акциями).
MARKETING_MAX_DISCOUNT_PERCENT=47

# Выкуп Stars (заявка «Продать»): ₽ за 100 ⭐ и лимиты.
SELL_OFFER_RUB_PER_100_STARS=750
SELL_MIN_STARS=100
SELL_MAX_STARS=50000

# Опционально: file_id картинки для первого экрана /start.
START_PHOTO_FILE_ID=

# Sentry (опционально). DSN не коммитить.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================================
# Универсальный вебхук «заказ оплачен» (свой оркестратор / YooKassa / и т.д., не LAVA)
# =============================================================================
# Длинная случайная строка. Без неё POST /v1/payments/provider-webhook отвечает 503.
# Подпись: hex HMAC-SHA256(PAYMENT_WEBHOOK_SECRET, raw_json_bytes), заголовок X-Payment-Signature: sha256=<hex>
# или просто <hex>.
#
# Пример тела JSON:
#   {"idempotency_key":"уникальная-строка-8-128","order_id":123,"action":"mark_paid"}
#
# Пример URL (после деплоя Partner API на порт 8090 за HTTPS-прокси):
#   POST https://ВАШ_ДОМЕН/v1/payments/provider-webhook
PAYMENT_WEBHOOK_SECRET=

# Эксплуатация: см. docs/RUNBOOK.md и docs/ACCEPTANCE_CHECKLIST.md
