# Скопируйте в .env и заполните.
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# База: USD -> RUB для отображения (обновляйте вручную или подключите API курсов).
USD_RUB_RATE=97.5

# Реферальные проценты (можно менять без правки кода, если добавите чтение в config).
REF_BUYER_FIRST_ORDER_DISCOUNT_PERCENT=7
REF_REFERRER_COMMISSION_FIRST_ORDER_PERCENT=15

# Опт на Stars от N звёзд в одной позиции.
STARS_WHOLESALE_THRESHOLD=500
STARS_WHOLESALE_DISCOUNT_PERCENT=5

# Крипто-реквизиты (показываются пользователю кнопкой «Крипта»).
CRYPTO_USDT_TRC20=
CRYPTO_TON=

# Заглушки под фиат-провайдеров (URL создаёте на своей стороне / вебхуке).
PAYMENT_YOOKASSA_RETURN_URL=https://t.me/your_bot

# Поддержка: полная ссылка (приоритет) или username без @ для https://t.me/...
SUPPORT_URL=
SUPPORT_USERNAME=
API_DOCS_URL=

# Partner HTTP API (отдельный процесс: python -m partner_api.main)
# Случайная длинная строка; без неё выпуск ключа в боте и старт API не работают.
API_KEY_PEPPER=
# Опционально: CORS origins через запятую для браузерных интеграций (лучше пусто — только server-to-server).
PARTNER_API_CORS_ORIGINS=

# Маркетинг «до N %» (отображение на /start; согласуйте с реальными акциями).
MARKETING_MAX_DISCOUNT_PERCENT=47

# Выкуп Stars (заявка «Продать»): ₽ за 100 ⭐ и лимиты.
SELL_OFFER_RUB_PER_100_STARS=750
SELL_MIN_STARS=100
SELL_MAX_STARS=50000

# Опционально: file_id картинки для первого экрана /start.
START_PHOTO_FILE_ID=

# Sentry (опционально). DSN не коммитить.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Входящий вебхук автоплатежей (HMAC тела, см. RUNBOOK раздел 9).
PAYMENT_WEBHOOK_SECRET=

# Эксплуатация: см. docs/RUNBOOK.md и docs/ACCEPTANCE_CHECKLIST.md
